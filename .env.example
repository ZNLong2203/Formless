# Evorozen Neural Pulse — the Virtual Database. This is the only datastore.
# Get a key at https://pulse.evorozen.com
EVOROZEN_API_KEY=evo_live_your_key_here

# Reasoning provider. Neural Pulse's own `chat` action is unavailable upstream,
# so entity extraction runs here. Gemini takes precedence when both are set;
# with neither, a deterministic extractor runs and the UI says so.
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash

# Alternative provider — same Zod schema, no other changes needed.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5
